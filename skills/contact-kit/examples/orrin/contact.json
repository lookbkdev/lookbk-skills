    "voice": "geist", "corners": "round"
  },
  "eyebrow": "Support and contact",
  "headline": "Tell us what is going on. _A person replies,_ not a bot.",
  "people": {
    "mara": { "name": "Mara Tesfaye", "role": "Support, Europe", "city": "Rotterdam", "tz": "Europe/Amsterdam", "hours": { "mon-fri": "08:00-17:00" } },
    "dan": { "name": "Daniel Ruiz", "role": "Support, Americas", "city": "Austin", "tz": "America/Chicago", "hours": { "mon-fri": "08:00-17:00" } },
    "yu": { "name": "Yu-Ting Chen", "role": "Support, Asia Pacific", "city": "Taipei", "tz": "Asia/Taipei", "hours": { "mon-fri": "08:00-17:00" } },
    "jonas": { "name": "Jonas Veld", "role": "Sales for teams", "city": "Rotterdam", "tz": "Europe/Amsterdam", "hours": { "mon-fri": "09:00-17:30" } }
  },
  "routes": [
    {
      "id": "fault", "title": "My Orrin is not working", "to": ["mara", "dan", "yu"], "desk": "Support desk",
      "reply": { "within": 2, "unit": "working-hours" }, "email": "help@orrin.example", "ref": "OR",
      "button": "Send to support",
      "fields": [
        { "k": "serial", "label": "Serial number", "required": true, "half": true, "mono": true, "hint": "on the base, starts with OR1", "placeholder": "OR1-0000-0000", "pattern": "OR1-[A-Z0-9]{4}-[A-Z0-9]{4}", "patternMessage": "Serial numbers look like OR1-4K7Q-82JD, on the base of the unit." },
        { "k": "email", "type": "email", "label": "Email", "required": true, "half": true },
        { "k": "led", "type": "swatch", "label": "What is the light doing", "hint": "on the front of the unit", "required": true, "options": [{ "label": "Steady green", "color": "#3fbf6f" }, { "label": "Blinking amber", "color": "#f2a33a" }, { "label": "Steady red", "color": "#ea4b3c" }, { "label": "No light", "color": "none" }] },
        { "k": "msg", "type": "textarea", "label": "What happened", "required": true, "placeholder": "What you saw, and since when." }
      ],
      "sent": { "headline": "Got it, {name}. {first} has it.", "read": "at the desk in {city}", "reply": "with a fix, or a replacement on its way" }
    },
    {
      "id": "return", "title": "A return or warranty claim", "to": ["mara", "dan", "yu"], "desk": "Support desk",
      "reply": { "within": 1, "unit": "working-days" }, "email": "returns@orrin.example", "ref": "RT",
      "button": "Start the return",
      "fields": [
        { "k": "order", "label": "Order number", "required": true, "half": true, "mono": true, "placeholder": "OR-000000", "pattern": "OR-[0-9]{6}", "patternMessage": "Order numbers look like OR-204871, in your receipt email." },
        { "k": "email", "type": "email", "label": "Email", "required": true, "half": true },
        { "k": "serial", "label": "Serial number", "required": true, "half": true, "mono": true, "hint": "on the base, starts with OR1", "placeholder": "OR1-0000-0000", "pattern": "OR1-[A-Z0-9]{4}-[A-Z0-9]{4}", "patternMessage": "Serial numbers look like OR1-4K7Q-82JD, on the base of the unit." },
        { "k": "why", "type": "choice", "label": "Why it is coming back", "required": true, "options": ["It is faulty", "Damaged in delivery", "Wrong item", "Changed my mind"] },
        { "k": "msg", "type": "textarea", "label": "Anything else" }
      ],
      "sent": { "headline": "Got it, {name}. {first} has it.", "read": "and checks your order", "reply": "with a return label and a drop-off point" }
    },
    {
      "id": "teams", "title": "Buying five or more", "to": ["jonas"],
      "reply": { "within": 1, "unit": "working-days" }, "email": "teams@orrin.example", "ref": "TS",
      "fields": [
        { "k": "name", "label": "Your name", "required": true, "half": true, "autocomplete": "name" },
        { "k": "email", "type": "email", "label": "Work email", "required": true, "half": true },
        { "k": "company", "label": "Company or school", "required": true, "half": true, "autocomplete": "organization" },
        { "k": "qty", "type": "select", "label": "How many", "options": ["5 to 9", "10 to 49", "50 or more"], "half": true },
        { "k": "msg", "type": "textarea", "label": "Where they will go" }
      ],
      "sent": { "headline": "Thanks, {name}. {first} has it.", "read": "in {city}", "reply": "with team pricing and lead times" }
    },
    {
      "id": "press", "title": "Press and partners", "to": ["jonas"],
      "reply": { "within": 2, "unit": "working-days" }, "email": "press@orrin.example", "ref": "PR",
      "fields": [
        { "k": "name", "label": "Your name", "required": true, "half": true, "autocomplete": "name" },
        { "k": "email", "type": "email", "label": "Email", "required": true, "half": true },
        { "k": "outlet", "label": "Publication or company", "required": true },
        { "k": "msg", "type": "textarea", "label": "What you have in mind", "required": true }
      ],
      "sent": { "headline": "Thanks, {name}. {first} has it.", "read": "in {city}", "reply": "with review units or a call" }
    }
  ],
